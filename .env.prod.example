# Copiar a /docker/app-almas/.env.prod en el VPS (chmod 600). No commitear.

APP_ENV=production

# Postgres (contenedor `db`)
POSTGRES_DB=almas
POSTGRES_USER=almas
POSTGRES_PASSWORD=cambia-esta-clave-larga

# Backend
DATABASE_URL=postgresql://almas:cambia-esta-clave-larga@db:5432/almas
JWT_SECRET=cambia-este-jwt-secret-largo-y-aleatorio
CORS_ORIGINS=https://almas.lionapp.cloud

# Imágenes GHCR (usar SHA o tag de release; evitar :latest en prod)
BACKEND_IMAGE=ghcr.io/lelion13/app-almas-backend:main
FRONTEND_IMAGE=ghcr.io/lelion13/app-almas-frontend:main

# Traefik (ajustar al resolver/entrypoint reales del VPS)
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# Migración de datos: poner 1 solo mientras restaurás un dump con schema incluido
# SKIP_DB_MIGRATE=1

# Mercado Pago Conciliación (OAuth)
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=https://almas.lionapp.cloud/api/v1/mp/oauth/callback
MP_OAUTH_FRONTEND_REDIRECT=https://almas.lionapp.cloud/conciliacion
# Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MP_TOKEN_ENCRYPTION_KEY=
MP_API_BASE_URL=https://api.mercadopago.com
MP_AUTH_BASE_URL=https://auth.mercadopago.com
MP_API_TIMEOUT_SECONDS=20
MP_REPORT_POLL_INTERVAL_SECONDS=2
MP_REPORT_POLL_TIMEOUT_SECONDS=180
MP_REPORT_CHUNK_DAYS=7

# Estudio: pause series/sessions/packs/booking APIs (410). Set false to re-enable temporarily.
STUDIO_SCHEDULE_PAUSED=true
